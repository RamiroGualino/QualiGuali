# Shared overrides for `docker-compose.yml` — copy to `.env` (gitignored)
# in the repo root before running `docker-compose up`. Every var here has a
# working default baked into docker-compose.yml for local dev, so an empty
# `.env` still works; override for anything closer to a real deployment.
#
# Per-service .env.example files under services/*/.env.example and
# apps/web/.env.example are still the source of truth when running a
# single service outside docker-compose (see docs/RUNBOOK.md).

# JWT — shared by every service, must be identical across all of them since
# each verifies tokens locally/statelessly (no round-trip to auth-service).
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1h

# Login brute-force rate limiting (auth-service only)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Bootstrap Super Admin — only consumed by auth-service's `pnpm seed`.
# There is no API endpoint that creates a Super Admin.
SUPER_ADMIN_EMAIL=super.admin@qualiguali.local
SUPER_ADMIN_PASSWORD=change-me

# S3-compatible storage (MinIO locally, real S3/IAM credentials in AWS) —
# used by execution-service for evidence files and raw automation reports,
# and by defects-service for defect evidence (photos/videos).
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=qualiguali-evidence
# Optional: override the host used to build Evidence.fileUrl, e.g. if
# MinIO's internal Docker hostname differs from a public-facing URL.
S3_PUBLIC_URL_BASE=
# Max size per uploaded Allure/Newman report file, in bytes. Default 50MB.
AUTOMATION_UPLOAD_MAX_BYTES=52428800

# Comma-separated allowlist of origins for CORS, applied by every backend
# service. Leave unset to reflect any request origin (permissive default,
# fine for local dev where the Vite dev server's port can vary).
CORS_ORIGIN=
