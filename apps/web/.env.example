# Base URLs of each backend service. There's no API Gateway yet (Parte 1),
# so the browser talks to each service directly — matches docker-compose's
# published ports.
VITE_AUTH_URL=http://localhost:4000
VITE_PROJECTS_URL=http://localhost:4001
VITE_QA_CORE_URL=http://localhost:4002
VITE_EXECUTION_URL=http://localhost:4003
VITE_DEFECTS_URL=http://localhost:4004
VITE_REPORTS_URL=http://localhost:4005
