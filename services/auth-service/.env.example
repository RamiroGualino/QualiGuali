# Server
PORT=4000
NODE_ENV=development

# Single MongoDB instance shared by all QualiGuali services (AD-002).
# This service only reads/writes its own collection: auth_users.
MONGODB_URI=mongodb://localhost:27017/qualiguali

# JWT — never hardcode this, especially in production.
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=1h

# Login brute-force rate limiting (per IP)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Bootstrap Super Admin — only used by `pnpm seed` (see README).
# There is no API endpoint that creates a Super Admin.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=super.admin@qualiguali.local
SUPER_ADMIN_PASSWORD=change-me

# Base URL of projects-service, used to validate assignedProjectIds when
# creating/editing a user from the Users module (Super Admin only).
PROJECTS_SERVICE_URL=http://localhost:4001

# Comma-separated allowlist of origins for CORS. Leave unset to reflect
# any request origin (permissive default, fine for local dev).
CORS_ORIGIN=
