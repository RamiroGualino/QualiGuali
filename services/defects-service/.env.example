# Server
PORT=4004
NODE_ENV=development

# Single MongoDB instance shared by all QualiGuali services (AD-002).
# This service only reads/writes its own collections:
# defects_defects, defects_defectComments, defects_counters.
MONGODB_URI=mongodb://localhost:27017/qualiguali

# Must match auth-service's JWT_SECRET — JWT is verified locally/stateless
# here too (no round-trip to auth-service on each request).
JWT_SECRET=change-me-in-every-environment

# Base URL of projects-service, used to synchronously validate projectId
# before creating a Defect.
PROJECTS_SERVICE_URL=http://localhost:4001

# Base URL of execution-service, used to synchronously validate
# linkedExecutionId / linkedAutomationTestResultId when provided.
EXECUTION_SERVICE_URL=http://localhost:4003

# SNS (LocalStack in local dev, real AWS in production) — where DefectCreated
# / DefectStatusChanged actually get published. If SNS_TOPIC_ARN is unset,
# events are only logged, not published (see @qualiguali/shared's
# createEventPublisher).
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:domain-events

# Comma-separated allowlist of origins for CORS. Leave unset to reflect
# any request origin (permissive default, fine for local dev).
CORS_ORIGIN=
