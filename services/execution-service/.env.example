# Server
PORT=4003
NODE_ENV=development

# Single MongoDB instance shared by all QualiGuali services (AD-002).
# This service only reads/writes its own collections:
# execution_executionCycles, execution_executions, execution_evidence,
# execution_automationRuns, execution_automationTestResults,
# execution_postmanSuites, execution_postmanSuiteVersions.
MONGODB_URI=mongodb://localhost:27017/qualiguali

# Must match auth-service's JWT_SECRET — JWT is verified locally/stateless
# here too (no round-trip to auth-service on each request).
JWT_SECRET=change-me-in-every-environment

# Base URL of qa-core-service, used to synchronously validate testCaseId
# before creating Executions.
QA_CORE_SERVICE_URL=http://localhost:4002

# Base URL of projects-service, used to synchronously validate projectId
# before creating an AutomationRun.
PROJECTS_SERVICE_URL=http://localhost:4001

# Max size per uploaded Allure/Newman report file, in bytes. Default 50MB.
AUTOMATION_UPLOAD_MAX_BYTES=52428800

# Max size per uploaded Postman collection/environment file, in bytes.
# Default 5MB — these are plain JSON, not binary reports.
POSTMAN_UPLOAD_MAX_BYTES=5242880

# S3-compatible storage for evidence files and raw automation reports. In
# local dev this points at the MinIO container from docker-compose.yml; in
# AWS it would point at a real S3 bucket/region instead.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qualiguali-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Optional: override the host used to build Evidence.fileUrl, e.g. if
# MinIO's internal Docker hostname differs from a public-facing URL.
S3_PUBLIC_URL_BASE=

# SNS (LocalStack in local dev, real AWS in production) — where domain
# events (ExecutionUpdated, CycleFinished, AutomationRunIngested) actually
# get published. If SNS_TOPIC_ARN is unset, events are only logged, not
# published (see @qualiguali/shared's createEventPublisher).
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:domain-events

# Comma-separated allowlist of origins for CORS. Leave unset to reflect
# any request origin (permissive default, fine for local dev).
CORS_ORIGIN=
