# Server
PORT=4005
NODE_ENV=development

# Single MongoDB instance shared by all QualiGuali services (AD-002).
# This service only reads/writes its own collections:
# reports_cycleReports, reports_trendPoints (the public read-model), plus a
# few internal-only ones — see README ("Colecciones internas no listadas").
MONGODB_URI=mongodb://localhost:27017/qualiguali

# Must match every other service's JWT_SECRET. Used both to verify JWTs on
# this service's own read endpoints, and to mint short-lived internal
# service tokens when the async event consumer calls execution-service
# (there's no end-user request to forward a token from there).
JWT_SECRET=change-me-in-every-environment

# Base URL of execution-service, used by the event consumer to fetch data
# that isn't present in the events themselves (cycle/project lookups,
# automation run details, evidence).
EXECUTION_SERVICE_URL=http://localhost:4003

# SNS/SQS (LocalStack in local dev, real AWS in production).
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# URL of the SQS queue subscribed to the shared "domain-events" SNS topic
# (see infra/localstack-init.sh). If unset, the event consumer is disabled
# and only the read endpoints run.
SQS_QUEUE_URL=http://localhost:4566/000000000000/reports-service-domain-events

# Comma-separated allowlist of origins for CORS. Leave unset to reflect
# any request origin (permissive default, fine for local dev).
CORS_ORIGIN=
